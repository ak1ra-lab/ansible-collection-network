#jinja2: lstrip_blocks: True, trim_blocks: True
# Generated by Ansible - managed by ak1ra_lab.network.netplan_static - DO NOT EDIT MANUALLY
#
# Captured from the live interface state.  The role is IPv4-only; IPv6
# addresses/routes are rejected unless netplan_static_allow_ipv6_loss is set.
network:
  version: 2
  renderer: networkd
  ethernets:
{% for interface in _netplan_static_interfaces %}
    {{ interface.name }}:
      match:
        macaddress: {{ interface.macaddress | ansible.builtin.to_json }}
      set-name: {{ interface.name }}
      dhcp4: false
      dhcp6: false
      accept-ra: false
      addresses:
{% for address in interface.addresses %}
        - {{ address | ansible.builtin.to_json }}
{% endfor %}
{% if interface.name == ansible_facts['default_ipv4']['interface'] and netplan_static_gateway | length > 0 %}
      routes:
        - to: default
          via: {{ netplan_static_gateway | ansible.builtin.to_json }}
{% endif %}
{% if interface.name == ansible_facts['default_ipv4']['interface'] and netplan_static_nameservers | length > 0 %}
      nameservers:
        addresses:
{% for nameserver in netplan_static_nameservers %}
          - {{ nameserver | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% endfor %}
