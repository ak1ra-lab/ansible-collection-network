# Generated by Ansible - DO NOT EDIT MANUALLY
# /etc/systemd/system/ansible-tproxy-routing.service
#
# Adds the ip rule (policy routing) and ip route (local default) entries
# needed for TPROXY to intercept locally-generated packets.
#
# Escape hatch: stopping this service removes the policy routing entries, so
# marked packets are no longer delivered locally - traffic flows directly
# without touching nftables.  Starting it again restores transparent proxying.
#
# Equivalent manual commands:
#   ip -4 rule add fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
#   ip -4 route add local default dev {{ tproxy_interface }} table {{ tproxy_route_table }}
{% if tproxy_enable_ipv6 %}
#   ip -6 rule add fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
#   ip -6 route add local default dev {{ tproxy_interface6 }} table {{ tproxy_route_table }}
{% endif %}

[Unit]
Description=TPROXY routing rules (ip rule + ip route)
Documentation=https://github.com/ak1ra-lab/ansible-collection-network
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# IPv4: remove any stale rules/routes before re-adding (idempotent)
ExecStartPre=-/usr/bin/ip -4 route del local default table {{ tproxy_route_table }}
ExecStartPre=-/usr/bin/ip -4 rule del fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
{% if tproxy_enable_ipv6 %}
# IPv6: remove any stale rules/routes before re-adding (idempotent)
ExecStartPre=-/usr/bin/ip -6 route del local default table {{ tproxy_route_table }}
ExecStartPre=-/usr/bin/ip -6 rule del fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
{% endif %}

# IPv4: add routing policy rule and local default route
ExecStart=/usr/bin/ip -4 rule add fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
ExecStart=/usr/bin/ip -4 route add local default dev {{ tproxy_interface }} table {{ tproxy_route_table }}
{% if tproxy_enable_ipv6 %}
# IPv6: add routing policy rule and local default route
ExecStart=/usr/bin/ip -6 rule add fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
ExecStart=/usr/bin/ip -6 route add local default dev {{ tproxy_interface6 }} table {{ tproxy_route_table }}
{% endif %}

# Remove routing rules/routes on stop (ignore errors if already absent)
ExecStop=-/usr/bin/ip -4 route del local default table {{ tproxy_route_table }}
ExecStop=-/usr/bin/ip -4 rule del fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
{% if tproxy_enable_ipv6 %}
ExecStop=-/usr/bin/ip -6 route del local default table {{ tproxy_route_table }}
ExecStop=-/usr/bin/ip -6 rule del fwmark {{ tproxy_fwmark }} lookup {{ tproxy_route_table }}
{% endif %}

[Install]
WantedBy=multi-user.target
