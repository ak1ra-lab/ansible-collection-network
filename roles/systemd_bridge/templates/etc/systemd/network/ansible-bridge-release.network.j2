#jinja2: lstrip_blocks: True, trim_blocks: True
# Generated by Ansible - managed by {{ _systemd_bridge_file_marker }} - DO NOT EDIT MANUALLY
#
# Keeps the host reachable when its bridge is removed (systemd_bridge_state:
# absent with absent_release_mode != none): before the bridge is dropped, the
# dedicated physical interface receives its own configuration so the host
# does not lose its last address.  The file takes over the regular
# 15-<interface>.network path (the enslave file is removed in the same run);
# the next systemd_bridge_state: present run replaces it with the enslave
# file again.  The interface now carries the host's connectivity itself, so
# RequiredForOnline keeps the systemd default (yes) and wait-online waits for
# it.
{% if bridge.absent_release_mode | default('none') == 'static' %}

[Match]
Name={{ bridge.interface }}

[Network]
Address={{ bridge.address }}
{% if bridge.gateway is defined and bridge.gateway %}
Gateway={{ bridge.gateway }}
{% endif %}
{% for server in bridge.dns | default([]) %}
DNS={{ server }}
{% endfor %}
{% else %}

[Match]
Name={{ bridge.interface }}

[Network]
DHCP=ipv4
{% endif %}
