#jinja2: lstrip_blocks: True, trim_blocks: True
# Generated by Ansible - managed by {{ _systemd_bridge_file_marker }} - DO NOT EDIT MANUALLY
#
# Host configuration for the systemd_bridge bridge itself, rendered for every
# bridge (10-<name>.netdev creates the device, this file manages the link).
# A bridge without a matching .network file is not managed by
# systemd-networkd, so the file exists even when the bridge stays a pure L2
# device.  `address` (plus `gateway`/`dns` when declared) gives the bridge -
# and thereby the host - an L3 presence on the segment; without them the
# [Match]/[Link] block alone makes networkd bring the link up.
#
# Carrier: a bridge with an enslaved physical interface gains carrier from
# that port and networkd configures it once it is up.  A bridge declared
# without an enslaved interface - a pure segment bridge whose ports (e.g.
# veth legs of a systemd_netns namespace) are attached later at run time -
# never has carrier on its own, so networkd would wait for it forever:
# such a bridge is configured without carrier (ConfigureWithoutCarrier=yes).
#
# RequiredForOnline: a bridge carrying the host's own address/gateway/dns is
# the host's connectivity endpoint, so it keeps the systemd default (yes)
# and systemd-networkd-wait-online waits for it.  Bridges that never reach
# an online operational state are excluded from wait-online instead of
# blocking or failing network-online.target at boot - a pure L2 bridge
# (no address, especially without an enslaved uplink there is no carrier at
# all) and every interface-less bridge (its segment ports attach only when
# the consumer service starts, which may order after network-online.target
# and would otherwise deadlock boot).

[Match]
Name={{ bridge.name }}

{% set _bridge_l3 = bridge.address is defined or (bridge.gateway is defined and bridge.gateway) or bridge.dns | default([]) | length %}
{% if _bridge_l3 and bridge.interface is defined %}
[Network]
{% if bridge.address is defined %}
Address={{ bridge.address }}
{% endif %}
{% if bridge.gateway is defined and bridge.gateway %}
Gateway={{ bridge.gateway }}
{% endif %}
{% for server in bridge.dns | default([]) %}
DNS={{ server }}
{% endfor %}
{% elif _bridge_l3 %}
[Network]
ConfigureWithoutCarrier=yes
{% if bridge.address is defined %}
Address={{ bridge.address }}
{% endif %}
{% if bridge.gateway is defined and bridge.gateway %}
Gateway={{ bridge.gateway }}
{% endif %}
{% for server in bridge.dns | default([]) %}
DNS={{ server }}
{% endfor %}

# RequiredForOnline is a [Link] section key (not [Network]); it is the
# option that keeps systemd-networkd-wait-online from waiting on this
# carrier-less bridge forever (veth legs attach only at run time, after
# network-online.target).
[Link]
RequiredForOnline=no
{% else %}
[Link]
RequiredForOnline=no
{% endif %}
