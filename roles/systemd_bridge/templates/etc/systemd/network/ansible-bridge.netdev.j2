# Generated by Ansible - managed by {{ _systemd_bridge_file_marker }} - DO NOT EDIT MANUALLY
#
# Linux bridge backing a dedicated L2 segment.  The bridge itself carries no
# address unless its own 20-<name>.network declares one - only enslaved ports
# (physical interfaces and veth legs of systemd_netns namespaces) are members
# by default.

[NetDev]
Name={{ bridge.name }}
Kind=bridge
Description=Ansible systemd_bridge bridge {{ bridge.name }}

[Bridge]
STP={{ bridge.stp | default(false) | ansible.builtin.bool | ansible.builtin.ternary('on', 'off') }}
ForwardDelaySec={{ bridge.forward_delay | default(0) }}
AgeingTimeSec={{ bridge.ageing_time | default(300) }}
MulticastSnooping={{ bridge.multicast_snooping | default(true) | ansible.builtin.bool | ansible.builtin.ternary('on', 'off') }}
VLANFiltering={{ bridge.vlan_filtering | default(false) | ansible.builtin.bool | ansible.builtin.ternary('on', 'off') }}
