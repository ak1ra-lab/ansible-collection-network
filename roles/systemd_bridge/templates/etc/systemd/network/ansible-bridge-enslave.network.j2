#jinja2: lstrip_blocks: True, trim_blocks: True
# Generated by Ansible - managed by {{ _systemd_bridge_file_marker }} - DO NOT EDIT MANUALLY
#
# Enslaves the dedicated physical interface into the systemd_bridge bridge.
# Matched by interface name; the interface must be dedicated to this bridge:
# no own address (addresses belong on the bridge device, not on an enslaved
# L2 port) and no other host network configuration for it.
#
# Promiscuous mode on the enslaved port is only forced when the bridge uses
# VLAN filtering: without it the kernel puts every bridge port into
# promiscuous mode itself (br_manage_promisc), while with it an
# offload-capable single auto-port may have its promisc mode cleared and
# inbound frames for MACs behind the bridge (namespace veth legs, further
# physical ports) would then be dropped by the NIC.
#
# RequiredForOnline=no: the enslaved port is a pure L2 member and never
# reaches an online operational state itself (host connectivity lives on the
# bridge, whose own file is required for online when it carries an address),
# so wait-online must not wait for the port.

[Match]
Name={{ bridge.interface }}

[Link]
{% if bridge.vlan_filtering | default(false) | ansible.builtin.bool %}
Promiscuous=yes
{% endif %}
RequiredForOnline=no

[Network]
Bridge={{ bridge.name }}
