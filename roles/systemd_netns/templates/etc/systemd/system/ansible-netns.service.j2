#jinja2: lstrip_blocks: True, trim_blocks: True
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Creates the network namespace {{ systemd_netns_name }} and attaches veth
# legs to the host-level Linux bridges declared in systemd_netns_links.  The
# bridges themselves are owned by ak1ra_lab.network.systemd_bridge (or the
# host's own network configuration) and must already exist.
# The namespace addresses/gateway live on the real bridged segments - the
# host does no routing, NAT or filtering for this traffic (pure L2).

[Unit]
Description=Network namespace {{ systemd_netns_name }} bridged to dedicated segments
Documentation=https://github.com/ak1ra-lab/ansible-collection-network
# Order after systemd-networkd so bridges created from its .netdev/.network
# files exist on boot; if the host carries its bridges without systemd-networkd
# this ordering is a no-op.
After=systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Clear stale artifacts from previous partial runs (idempotent restarts)
ExecStartPre=-/usr/bin/ip netns del {{ systemd_netns_name }}
{% for link in systemd_netns_links %}
ExecStartPre=-/usr/bin/ip link del {{ _systemd_netns_veth_host_prefix }}-{{ loop.index0 }}
{% endfor %}

# Creation
ExecStart=/usr/bin/ip netns add {{ systemd_netns_name }}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} ip link set lo up

# veth legs: host end = bridge port (L2), namespace end = segment address
{% for link in systemd_netns_links %}
ExecStart=/usr/bin/ip link add {{ _systemd_netns_veth_host_prefix }}-{{ loop.index0 }} type veth peer name {{ _systemd_netns_veth_ns_prefix }}-{{ loop.index0 }}
ExecStart=/usr/bin/ip link set {{ _systemd_netns_veth_host_prefix }}-{{ loop.index0 }} master {{ link.bridge }}
ExecStart=/usr/bin/ip link set {{ _systemd_netns_veth_host_prefix }}-{{ loop.index0 }} up
ExecStart=/usr/bin/ip link set {{ _systemd_netns_veth_ns_prefix }}-{{ loop.index0 }} netns {{ systemd_netns_name }}
{% if link.mac is defined and link.mac %}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} ip link set {{ _systemd_netns_veth_ns_prefix }}-{{ loop.index0 }} address {{ link.mac }}
{% endif %}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} ip addr add {{ link.address }} dev {{ _systemd_netns_veth_ns_prefix }}-{{ loop.index0 }}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} ip link set {{ _systemd_netns_veth_ns_prefix }}-{{ loop.index0 }} up
{% if link.gateway is defined %}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} ip route replace default via {{ link.gateway }} dev {{ _systemd_netns_veth_ns_prefix }}-{{ loop.index0 }}
{% endif %}
{% endfor %}
{% if systemd_netns_disable_ipv6 | ansible.builtin.bool %}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} /usr/sbin/sysctl -qw net.ipv6.conf.all.disable_ipv6=1
{% endif %}

# Per-netns sysctls are re-applied here on every namespace (re)creation.
# Only namespaced keys are isolated to this namespace (net.ipv4.* /
# net.ipv6.* / conf.* and a few net.core.* keys like somaxconn);
# net.core.rmem_max / wmem_max and other global keys written below change
# the whole host.
{% for _sysctl_key, _sysctl_value in systemd_netns_sysctl_params.items() %}
ExecStart=/usr/bin/ip netns exec {{ systemd_netns_name }} /usr/sbin/sysctl -qw "{{ _sysctl_key }}={{ _sysctl_value }}"
{% endfor %}

# Teardown (network namespace first; veth peers inside it die with it, the
# host legs are removed afterwards)
ExecStop=-/usr/bin/ip netns del {{ systemd_netns_name }}
{% for link in systemd_netns_links %}
ExecStop=-/usr/bin/ip link del {{ _systemd_netns_veth_host_prefix }}-{{ loop.index0 }}
{% endfor %}

[Install]
WantedBy=multi-user.target
