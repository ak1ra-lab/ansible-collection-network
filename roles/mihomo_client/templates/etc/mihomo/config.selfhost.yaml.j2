# Custom overrides first (rendered only when the matching payload is set),
# then the direct sets (geosite-steam@cn keeps the Steam CDN/download
# domains direct and resolved nearby), then the application routing.
rules:
{% if mihomo_client_custom_internal_rule_set_payload | length > 0 %}
  - RULE-SET,custom-internal-rule-set,DIRECT
{% endif %}
{% if mihomo_client_custom_rejected_rule_set_payload | length > 0 %}
  - RULE-SET,custom-rejected-rule-set,REJECT
{% endif %}
{% if mihomo_client_custom_rejected_rule_set_ip_payload | length > 0 %}
  - RULE-SET,custom-rejected-rule-set-ip,REJECT
{% endif %}
{% if mihomo_client_custom_direct_rule_set_payload | length > 0 %}
  - RULE-SET,custom-direct-rule-set,DIRECT
{% endif %}
{% if mihomo_client_custom_direct_rule_set_ip_payload | length > 0 %}
  - RULE-SET,custom-direct-rule-set-ip,DIRECT
{% endif %}
{% if mihomo_client_custom_proxied_rule_set_payload | length > 0 %}
  - RULE-SET,custom-proxied-rule-set,PROXY
{% endif %}
{% if mihomo_client_custom_proxied_rule_set_ip_payload | length > 0 %}
  - RULE-SET,custom-proxied-rule-set-ip,PROXY
{% endif %}
  - RULE-SET,geosite-private,DIRECT
  - RULE-SET,geoip-private,DIRECT
  - RULE-SET,geosite-cn,DIRECT
  - RULE-SET,geoip-cn,DIRECT
  - RULE-SET,geosite-steam@cn,DIRECT
  - RULE-SET,geosite-category-ai-!cn,AI
