  # selector tier (all nodes of the region, self-hosted excluded)
  - name: 🇸🇬 新加坡节点
    type: select
    include-all: true
    filter: (?i:\bSG[P]?\d*\b|Singapore|新加坡|狮城)
    exclude-filter: selfhost|自建
  - name: 🇭🇰 香港节点
    type: select
    include-all: true
    filter: (?i:\bHK[G]?\d*\b|Hong.*?Kong|\bHKT\b|\bHKBN\b|\bHGC\b|\bWTT\b|\bCMI\b|香港)
    exclude-filter: selfhost|自建
  - name: 🇹🇼 台湾节点
    type: select
    include-all: true
    filter: (?i:\bTW[N]?\d*\b|Taiwan|新北|彰化|\bCHT\b|台湾|[^-]台|\bHINET\b)
    exclude-filter: selfhost|自建
  - name: 🇯🇵 日本节点
    type: select
    include-all: true
    filter: (?i:\bJP[N]?\d*\b|Japan|Tokyo|Osaka|Saitama|日本|东京|大阪|埼玉)
    exclude-filter: selfhost|自建
  - name: 🇺🇸 美国节点
    type: select
    include-all: true
    filter: (?i:\bUS[A]?\d*\b|America|United.*?States|美国|[^-]美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥)
    exclude-filter: selfhost|自建
  - name: 🚀 所有节点
    type: select
    include-all: true

  # AUTO tier (url-test over the same pool)
  - name: 🇸🇬 新加坡节点 - AUTO
    type: url-test
    include-all: true
    filter: (?i:\bSG[P]?\d*\b|Singapore|新加坡|狮城)
    exclude-filter: selfhost|自建
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🇭🇰 香港节点 - AUTO
    type: url-test
    include-all: true
    filter: (?i:\bHK[G]?\d*\b|Hong.*?Kong|\bHKT\b|\bHKBN\b|\bHGC\b|\bWTT\b|\bCMI\b|香港)
    exclude-filter: selfhost|自建
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🇹🇼 台湾节点 - AUTO
    type: url-test
    include-all: true
    filter: (?i:\bTW[N]?\d*\b|Taiwan|新北|彰化|\bCHT\b|台湾|[^-]台|\bHINET\b)
    exclude-filter: selfhost|自建
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🇯🇵 日本节点 - AUTO
    type: url-test
    include-all: true
    filter: (?i:\bJP[N]?\d*\b|Japan|Tokyo|Osaka|Saitama|日本|东京|大阪|埼玉)
    exclude-filter: selfhost|自建
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🇺🇸 美国节点 - AUTO
    type: url-test
    include-all: true
    filter: (?i:\bUS[A]?\d*\b|America|United.*?States|美国|[^-]美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥)
    exclude-filter: selfhost|自建
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🚀 所有节点 - AUTO
    type: url-test
    include-all: true
    exclude-filter: selfhost|自建
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50

  # self-hosted tier (US/SG/JP; other regions are covered by the catch-all)
  - name: 🇸🇬 新加坡节点 - 自建
    type: select
    include-all: true
    filter: (?=.*(?:selfhost|自建))(?=.*(?:(?i:\bSG[P]?\d*\b|Singapore|新加坡|狮城)))
  - name: 🇯🇵 日本节点 - 自建
    type: select
    include-all: true
    filter: (?=.*(?:selfhost|自建))(?=.*(?:(?i:\bJP[N]?\d*\b|Japan|Tokyo|Osaka|Saitama|日本|东京|大阪|埼玉)))
  - name: 🇺🇸 美国节点 - 自建
    type: select
    include-all: true
    filter: (?=.*(?:selfhost|自建))(?=.*(?:(?i:\bUS[A]?\d*\b|America|United.*?States|美国|[^-]美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥)))
  - name: 🚀 所有节点 - 自建
    type: select
    include-all: true
    filter: selfhost|自建

# Inline custom rule sets: a set (and its rule below) only exists when the
# matching mihomo_client_custom_*_payload list is non-empty.  Domain sets
# take domains, the `-ip` sets take CIDRs; `path-in-bundle` extracts the
# .mrs members from BundleMRS.7z on first use.
rule-providers:
{% for name, rule_set in _custom_rule_sets.items() if rule_set.payload | length > 0 %}
  {{ name }}:
    type: inline
    behavior: {{ rule_set.behavior }}
    format: yaml
    payload:
{% for value in rule_set.payload %}
      - {{ value | ansible.builtin.to_json }}
{% endfor %}

{% endfor %}
  geosite-private:
    type: file
    behavior: domain
    format: mrs
    path: ./rules/geo/geosite/private.mrs
    path-in-bundle: geo/geosite/private.mrs
    interval: 2592000
  geosite-cn:
